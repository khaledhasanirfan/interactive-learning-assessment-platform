# ==============================================================================
# CLIENT-SIDE FIREBASE CONFIGURATION (Publicly Safe / Restricted by App Check)
# ==============================================================================
NEXT_PUBLIC_FIREBASE_API_KEY=AIzaSyFakeKeyForLocalDevelopment12345
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=os-assessment-platform.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=os-assessment-platform
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=os-assessment-platform.appspot.com
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=123456789012
NEXT_PUBLIC_FIREBASE_APP_ID=1:123456789012:web:abcdef1234567890abcdef

# Firebase App Check Site Key (reCAPTCHA v3 or Enterprise Site Key)
NEXT_PUBLIC_APP_CHECK_SITE_KEY=

# Local Emulators (Set to "true" to point client SDK to localhost emulators)
NEXT_PUBLIC_USE_FIREBASE_EMULATORS=true
NEXT_PUBLIC_FIREBASE_AUTH_EMULATOR_HOST=http://127.0.0.1:9099
NEXT_PUBLIC_FIRESTORE_EMULATOR_HOST=127.0.0.1:8080

# Demo Mode (Allows instant 1-click persona switching for grading & assessment inspection)
NEXT_PUBLIC_DEMO_MODE=true

# ==============================================================================
# SERVER-SIDE SECRETS (NEVER COMMITTED OR EXPOSED TO CLIENT BUNDLES)
# ==============================================================================
# In production, injected via Google Cloud Secret Manager / Firebase App Hosting
FIREBASE_ADMIN_PROJECT_ID=os-assessment-platform
FIREBASE_ADMIN_CLIENT_EMAIL=firebase-adminsdk-xxxxx@os-assessment-platform.iam.gserviceaccount.com
FIREBASE_ADMIN_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nMIIEvgIBADANBgkqhkiG9w0BAQEFAASCBKgwggSkAgEAAoIBAQC...\n-----END PRIVATE KEY-----\n"

# Optional Gemini API Key (Server-side only for optional question assistance)
GEMINI_API_KEY=
